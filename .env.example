# --- Supabase (the real warehouse target) ---
# Project Settings > API for these two:
SUPABASE_URL=
SUPABASE_KEY=
# Project Settings > Database > Connection string (direct, not the pooler,
# for the schema/seed scripts — psycopg needs a plain Postgres URL here):
SUPABASE_DB_URL=

# --- MCP ---
# Required in production (see utils/auth.py) — bearer token remote clients
# must send as `Authorization: Bearer <value>`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Local warehouse Postgres (docker-compose) ---
# Offline dev fallback only, used when SUPABASE_DB_URL above is empty.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
